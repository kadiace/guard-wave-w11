// GuardWave 3D particle-in-cell solver. All fluid state stays on the GPU.
#pragma kernel ClearGrid
#pragma kernel ClassifyGrid
#pragma kernel Spawn
#pragma kernel InitializeAmbient
#pragma kernel RecycleAmbient
#pragma kernel DriveInlet
#pragma kernel EmitCrest
#pragma kernel ParticleToGrid
#pragma kernel NormalizeGrid
#pragma kernel BuildFaces
#pragma kernel JacobiPressure
#pragma kernel ProjectFaces
#pragma kernel ProjectGrid
#pragma kernel GridToParticle
#pragma kernel PressureToBodies
#pragma kernel Waterfall
#pragma kernel ClearExitCounts
#pragma kernel UpdateExitFlux

#define SCALE 2048.0
#define MAX_COLLIDERS 256

struct FluidParticle
{
    float4 position; // xyz and alive flag
    float4 velocity;
    float4 affineX;
    float4 affineY;
    float4 affineZ;
};
struct FluidCollider
{
    float4 centerBody; // xyz, body index (-1 for static)
    float4 extentType; // xyz half-extents, w type: 0 box, 1 sphere, 2 capsule
    float4 rotation;
    float4 velocity;
    float4 angular;
    float4 bodyCenter;
};
RWStructuredBuffer<FluidParticle> _Particles;
// [0..3] legacy counters; [4..] per-XY-cell cliff departures THIS physics tick.
RWStructuredBuffer<uint> _FlowCounters; // [0] pending refill, [1] total refilled, [2] per-tick claims, [3] cliff exits
RWStructuredBuffer<uint> _CrestMetrics; // active wave particles, peak height centimeters, released count
// Per-step outflow diagnostics, disabled unless Ctrl+G is enabled.
// 0 fluid grid cells, 1 reverse pre-projection, 2 reverse post-projection,
// 3 projection sign flips, 4 particles sampled, 5 reverse before collision,
// 6 reverse after collision/crest, 7 collision sign flips, 8 cliff exits,
// 9/10 maximum +Z grid speed (millimeters/s) before/after projection,
// 11 maximum +Z particle speed (millimeters/s),
// 12 total lip departures (whole river), 13 reconstructed outlet flux (liters/s).
RWStructuredBuffer<uint> _OutflowDiagnostics;
int _OutflowDiagnosticsEnabled;
RWStructuredBuffer<int4> _Accum;
RWStructuredBuffer<int4> _BodyImpulses; // force impulse in xyz, torque in next xyz
RWStructuredBuffer<float3> _GridVelocity;
// Staggered positive X/Y/Z faces; negative faces live in neighboring cells.
RWStructuredBuffer<float3> _FaceVelocity;
RWStructuredBuffer<float3> _GridBefore;
StructuredBuffer<float3> _GridBeforeRead;
RWStructuredBuffer<float> _PressureSrc;
RWStructuredBuffer<float> _PressureDst;
RWStructuredBuffer<uint> _Solid;
StructuredBuffer<FluidCollider> _Colliders;
// Observed lip volume is diagnostic, not a second pressure sink.
RWStructuredBuffer<float> _LipFaceFlux;
float _CoupledOutletLength;
float _CoupledOutletDepth;
float _OutletParticleVolume;
int3 _GridSize;
float3 _GridOrigin;
float _CellSize;
float _Dt;
float _Gravity;
float _FlipFraction;
float _ParticleMass;
float _HydroDensity;
float _PressureClamp;
float _PressureThreshold;
float _CollisionResponse;
float _CollisionSkin;
float _MaxFluidVelocity;
float _FloorY;
float _ExitZ;
float _WaterfallEndY;
float _HalfWidth;
float _InletZ;
float _WaveHeight;
float _InletVelocity;
float _AmbientDepth;
float _CrestHeightStiffness;
float _CrestHeightDamping;
float _CrestForwardDamping;
float _CrestReleaseDistance;
uint _CrestSlotStart;
int3 _AmbientGrid;
uint _AmbientInitialCount;
uint _AmbientEnabled;
uint _AmbientRefillBudget;
int3 _CrestGrid;
float _CrestAmplitude;
float _CrestSpeed;
float _CrestWidth;
float _CrestLength;
float _CrestCenterZ;
uint _ParticleCount;
uint _SpawnStart;
uint _SpawnCount;
uint _SpawnSeed;
uint _ColliderCount;
uint _BodyCount;

uint Flatten(int3 c)
{
    return (uint)((c.z * _GridSize.y + c.y) * _GridSize.x + c.x);
}
bool Inside(int3 c)
{
    return all(c >= 0) && all(c < _GridSize);
}
float3 Center(int3 c)
{
    return _GridOrigin + ((float3)c + 0.5) * _CellSize;
}
float3 Rotate(float4 q, float3 v)
{
    return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}
float SignedDistance(FluidCollider b, float3 p)
{
    float4 inv = float4(-b.rotation.xyz, b.rotation.w);
    float3 local = Rotate(inv, p - b.centerBody.xyz);
    if (b.extentType.w > 1.5)
    {
        local.y -= clamp(local.y, -b.extentType.y, b.extentType.y);
        return length(local) - b.extentType.x;
    }
    if (b.extentType.w > 0.5)
        return length(local) - b.extentType.x;
    float3 q = abs(local) - b.extentType.xyz;
    return length(max(q, 0)) + min(max(q.x, max(q.y, q.z)), 0);
}
float3 ColliderNormal(FluidCollider b, float3 p)
{
    float e = _CellSize * 0.1;
    float3 n = float3(
        SignedDistance(b, p + float3(e, 0, 0)) - SignedDistance(b, p - float3(e, 0, 0)),
        SignedDistance(b, p + float3(0, e, 0)) - SignedDistance(b, p - float3(0, e, 0)),
        SignedDistance(b, p + float3(0, 0, e)) - SignedDistance(b, p - float3(0, 0, e)));
    return dot(n, n) > 0.000001 ? normalize(n) : float3(0, 1, 0);
}
// The downstream (-Z) face is an outlet, not a no-flow solid wall.
// Other domain faces retain their previous solid boundary conditions.
bool IsOpenOutflow(int3 c)
{
    return c.z < 0 && c.x >= 0 && c.x < _GridSize.x
        && c.y >= 0 && c.y < _GridSize.y;
}
bool IsSolid(int3 c)
{
    if (IsOpenOutflow(c)) return false;
    if (!Inside(c)) return true;
    return _Solid[Flatten(c)] != 0;
}
// Limit diagnostic atomics and markers to the central strip directly before the lip.
bool InOutflowDiagnosticZone(float3 p)
{
    return abs(p.x) <= 8.0 && p.z >= _ExitZ && p.z <= _ExitZ + 6.0;
}
bool IsFluid(int3 c)
{
    return Inside(c) && !IsSolid(c) && _Accum[Flatten(c)].w > (int)(SCALE * 0.01);
}
float3 VelocityAt(int3 c)
{
    return IsFluid(c) ? _GridVelocity[Flatten(c)] : 0;
}
float3 MacAt(int3 c)
{
    return Inside(c) ? _FaceVelocity[Flatten(c)] : float3(0,0,0);
}
float PressureAt(int3 c, float own)
{
    // Zero-gauge pressure at the free downstream outlet allows pressure
    // projection to push liquid over the cliff rather than reflect it.
    if (IsOpenOutflow(c)) return 0.0;
    if (IsSolid(c)) return own;
    return IsFluid(c) ? _PressureSrc[Flatten(c)] : 0.0;
}
[numthreads(128,1,1)]
void ClearGrid(uint id : SV_DispatchThreadID)
{
    uint cells = _GridSize.x * _GridSize.y * _GridSize.z;
    if (id < cells)
    {
        _Accum[id] = int4(0,0,0,0);
        _GridVelocity[id] = 0;
        _PressureSrc[id] = 0;
        _PressureDst[id] = 0;
    }
    if (id < _BodyCount * 2)
        _BodyImpulses[id] = int4(0,0,0,0);
    if (id < 3)
        _CrestMetrics[id] = 0u;
    if (_OutflowDiagnosticsEnabled != 0 && id < 14)
        _OutflowDiagnostics[id] = 0u;
    // Keep pending refill debt and its global sequence across physics ticks.
    if (id == 0 && _AmbientEnabled != 0)
        _FlowCounters[2] = 0u;
}
// The extra FlowCounters entries share the G2P UAV already bound by this solver.
// Clearing here rather than ClearGrid keeps ClearGrid <= 8 UAVs.
[numthreads(128,1,1)]
void ClearExitCounts(uint id : SV_DispatchThreadID)
{
    uint faces = (uint)(_GridSize.x * _GridSize.y);
    if (id < faces) _FlowCounters[4u + id] = 0u;
}
[numthreads(128,1,1)]
void ClassifyGrid(uint id : SV_DispatchThreadID)
{
    uint cells = _GridSize.x * _GridSize.y * _GridSize.z;
    if (id >= cells) return;
    int x = id % _GridSize.x;
    int y = (id / _GridSize.x) % _GridSize.y;
    int z = id / (_GridSize.x * _GridSize.y);
    float3 pos = Center(int3(x,y,z));
    // The bed ends at the actual waterfall lip. Do not continue its
    // collision/pressure wall into the downstream outlet buffer.
    bool solid = (pos.y <= _FloorY && pos.z >= _ExitZ) ||
        abs(pos.x) >= _HalfWidth;
    [loop]
    for (uint i = 0; i < _ColliderCount && !solid; ++i)
    {
        FluidCollider b = _Colliders[i];
        float3 dr = pos - b.centerBody.xyz;
        if (dot(dr, dr) > b.velocity.w * b.velocity.w) continue;
        solid = SignedDistance(b, pos) <= 0;
    }
    _Solid[id] = solid ? 1 : 0;
}
[numthreads(128,1,1)]
void Spawn(uint id : SV_DispatchThreadID)
{
    if (id >= _SpawnCount) return;
    uint index = _SpawnStart + id;
    // Mix the candidate lattice coordinates instead of filling the river from one side.
    uint widthCells = max(1u, (uint)floor(_HalfWidth * 2.0 / (_CellSize * 0.85)));
    uint heightCells = max(1u, (uint)floor(_WaveHeight / (_CellSize * 0.85)));
    uint layerCells = 3;
    uint span = widthCells * heightCells * layerCells;
    uint chosen = (id * 7919u + _SpawnSeed * 1543u) % span;
    uint ix = chosen % widthCells;
    uint iy = (chosen / widthCells) % heightCells;
    uint iz = (chosen / (widthCells * heightCells)) % layerCells;
    float spacing = _CellSize * 0.85;
    FluidParticle p = (FluidParticle)0;
    p.position = float4(
        (ix + 0.5) * (2.0 * _HalfWidth / widthCells) - _HalfWidth,
        _FloorY + (iy + 0.5) * (_WaveHeight / heightCells),
        _InletZ - (iz + 0.5) * spacing, 1);
    p.velocity = float4(0, 0, -_InletVelocity, 0);
    _Particles[index] = p;
}
// The initial 1m river is present before any Ready click.
[numthreads(128,1,1)]
void InitializeAmbient(uint id : SV_DispatchThreadID)
{
    if (id >= _ParticleCount) return;
    FluidParticle p = (FluidParticle)0;
    if (id < _AmbientInitialCount)
    {
        uint x = id % (uint)_AmbientGrid.x;
        uint y = (id / (uint)_AmbientGrid.x) % (uint)_AmbientGrid.y;
        uint z = id / (uint)(_AmbientGrid.x * _AmbientGrid.y);
        p.position = float4(
            -_HalfWidth + (x + 0.5) * (2.0 * _HalfWidth / _AmbientGrid.x),
            _FloorY + (y + 0.5) * (_AmbientDepth / _AmbientGrid.y),
            _ExitZ + (z + 0.5) * ((_InletZ + _CellSize - _ExitZ) / _AmbientGrid.z), 1.0);
        p.velocity = float4(0, 0, -_InletVelocity, 0);
    }
    _Particles[id] = p;
}

// Preserve refill debt until inactive slots become available, even while the
// waterfall occupies the spare GPU particle slots. All refill accounting stays
// on the GPU; a wave crest (velocity.w = 1) is never counted as base water.
[numthreads(128,1,1)]
void RecycleAmbient(uint id : SV_DispatchThreadID)
{
    // Preserve dedicated wave slots even when the river is full of waterfall
    // spray. Otherwise EmitCrest randomly skips candidates as slots run out.
    if (id >= _ParticleCount || id >= _CrestSlotStart) return;
    FluidParticle p = _Particles[id];
    if (p.position.w != 0.0) return;

    // A faster inlet supplies more particles per second, but each physics
    // tick has a finite, speed-derived budget. Claim before withdrawing a
    // lost-water ticket so we cannot flood the creek on a sudden backlog.
    uint claim;
    InterlockedAdd(_FlowCounters[2], 1u, claim);
    if (claim >= _AmbientRefillBudget) return;

    uint pending;
    InterlockedAdd(_FlowCounters[0], 0u, pending);
    while (pending > 0u)
    {
        uint observed;
        InterlockedCompareExchange(_FlowCounters[0], pending, pending - 1u, observed);
        if (observed == pending)
        {
            uint ticket;
            InterlockedAdd(_FlowCounters[1], 1u, ticket);
            uint width = (uint)_AmbientGrid.x;
            uint layers = (uint)_AmbientGrid.y;
            uint chosen = (ticket * 7919u + _SpawnSeed * 1543u) %
                (width * layers * 2u);
            uint x = chosen % width;
            uint y = (chosen / width) % layers;
            uint z = chosen / (width * layers);
            p = (FluidParticle)0;
            p.position = float4(
                -_HalfWidth + (x + 0.5) * (2.0 * _HalfWidth / width),
                _FloorY + (y + 0.5) * (_AmbientDepth / layers),
                _InletZ + _CellSize + (z + 0.5) * (_CellSize * 0.85), 1.0);
            p.velocity = float4(0, 0, -_InletVelocity, 0);
            _Particles[id] = p;
            return;
        }
        pending = observed;
    }
}

// A steady inlet keeps the background creek moving even when its P2G/pressure
// projection slows the flow. The stronger wave particles are not affected.
[numthreads(128,1,1)]
void DriveInlet(uint id : SV_DispatchThreadID)
{
    if (id >= _ParticleCount) return;
    FluidParticle p = _Particles[id];
    if (p.position.w != 1.0 || p.velocity.w > 0.5) return;
    float distance = _InletZ - p.position.z;
    float region = 3.0;
    if (distance < -_CellSize * 2.0 || distance > region) return;
    float influence = saturate((region - max(distance, 0.0)) / region);
    p.velocity.z = lerp(p.velocity.z, -_InletVelocity,
        saturate(_Dt * 6.0 * influence));
    _Particles[id] = p;
}

// One Ready event emits a deterministic, contiguous 3m excess-water volume.
// Its entire lattice occupies GPU slots reserved at initialization, so
// active waterfall or ambient particles cannot steal some of the wave.
[numthreads(128,1,1)]
void EmitCrest(uint id : SV_DispatchThreadID)
{
    uint width = (uint)_CrestGrid.x;
    uint layers = (uint)_CrestGrid.y;
    uint rows = (uint)_CrestGrid.z;
    if (id >= width * layers * rows) return;
    uint slot = _CrestSlotStart + id;
    if (slot >= _ParticleCount) return;

    uint x = id % width;
    uint y = (id / width) % layers;
    uint z = id / (width * layers);
    float fraction = (z + 0.5) / rows;
    float worldZ = _InletZ - (z + 0.5) * (_CrestLength / rows);
    float taper = clamp(_CrestWidth / _CrestLength, 0.05, 0.45);
    float front = smoothstep(0.0, taper, fraction);
    float back = smoothstep(0.0, taper, 1.0 - fraction);
    float excess = (y + 0.5) * (_CrestAmplitude / layers);

    // Always overwrite the reserved slot, even at the tapered ends.
    FluidParticle p = (FluidParticle)0;
    if (excess <= _CrestAmplitude * min(front, back))
    {
        p.position = float4(
            -_HalfWidth + (x + 0.5) * (2.0 * _HalfWidth / width),
            _FloorY + _AmbientDepth + excess,
            worldZ, 1.0);
        p.velocity = float4(0, 0, -_CrestSpeed, 1.0);
        // APIC affine .w channels are unused by P2G. Keep the intended
        // height and a sticky collision-release bit across FLIP steps.
        p.affineX.w = excess;
        p.affineY.w = 0.0;
    }
    _Particles[slot] = p;
}

[numthreads(128,1,1)]
void ParticleToGrid(uint id : SV_DispatchThreadID)
{
    if (id >= _ParticleCount) return;
    FluidParticle p = _Particles[id];
    if (p.position.w != 1.0) return;
    float3 g = (p.position.xyz - _GridOrigin) / _CellSize - 0.5;
    int3 baseCell = (int3)floor(g);
    float3 f = frac(g);
    [unroll]
    for (int z = 0; z <= 1; z++)
    [unroll]
    for (int y = 0; y <= 1; y++)
    [unroll]
    for (int x = 0; x <= 1; x++)
    {
        int3 c = baseCell + int3(x,y,z);
        if (!Inside(c) || IsSolid(c)) continue;
        float3 d = Center(c) - p.position.xyz;
        float3 affine = p.affineX.xyz * d.x + p.affineY.xyz * d.y + p.affineZ.xyz * d.z;
        float3 v = p.velocity.xyz + affine;
        float w = (x == 0 ? 1-f.x : f.x) * (y == 0 ? 1-f.y : f.y) *
            (z == 0 ? 1-f.z : f.z);
        uint idx = Flatten(c);
        InterlockedAdd(_Accum[idx].x, (int)round(v.x * w * SCALE));
        InterlockedAdd(_Accum[idx].y, (int)round(v.y * w * SCALE));
        InterlockedAdd(_Accum[idx].z, (int)round(v.z * w * SCALE));
        InterlockedAdd(_Accum[idx].w, (int)round(w * SCALE));
    }
}
[numthreads(128,1,1)]
void NormalizeGrid(uint id : SV_DispatchThreadID)
{
    uint cells = _GridSize.x * _GridSize.y * _GridSize.z;
    if (id >= cells) return;
    int4 sum = _Accum[id];
    float3 v = sum.w > 0 ? float3(sum.xyz) / sum.w : 0;
    _GridBefore[id] = v;
    _GridVelocity[id] = _Solid[id] == 0 && sum.w > 0
        ? v + float3(0, -_Gravity * _Dt, 0) : 0;
}
// Assemble a staggered velocity field from existing APIC cell samples.
// Liquid/solid faces are no-flow, liquid/air faces remain free.
[numthreads(128,1,1)]
void BuildFaces(uint id : SV_DispatchThreadID)
{
    uint cells = _GridSize.x * _GridSize.y * _GridSize.z;
    if (id >= cells) return;
    int3 c = int3(id % _GridSize.x,
        (id / _GridSize.x) % _GridSize.y,
        id / (_GridSize.x * _GridSize.y));
    int3 ex = int3(1,0,0), ey = int3(0,1,0), ez = int3(0,0,1);
    bool wet = IsFluid(c);
    float3 own = wet ? _GridVelocity[id] : float3(0,0,0);
    float3 face = float3(0,0,0);
    int3 nx = c+ex, ny = c+ey, nz = c+ez;
    if (!IsSolid(c) && !IsSolid(nx) && (wet || IsFluid(nx)))
    {
        bool other = IsFluid(nx);
        face.x = wet && other ? 0.5*(own.x+_GridVelocity[Flatten(nx)].x) :
            wet ? own.x : _GridVelocity[Flatten(nx)].x;
    }
    if (!IsSolid(c) && !IsSolid(ny) && (wet || IsFluid(ny)))
    {
        bool other = IsFluid(ny);
        face.y = wet && other ? 0.5*(own.y+_GridVelocity[Flatten(ny)].y) :
            wet ? own.y : _GridVelocity[Flatten(ny)].y;
    }
    if (!IsSolid(c) && !IsSolid(nz) && (wet || IsFluid(nz)))
    {
        bool other = IsFluid(nz);
        face.z = wet && other ? 0.5*(own.z+_GridVelocity[Flatten(nz)].z) :
            wet ? own.z : _GridVelocity[Flatten(nz)].z;
    }
    _FaceVelocity[id] = face;
}
[numthreads(128,1,1)]
void JacobiPressure(uint id : SV_DispatchThreadID)
{
    uint cells = _GridSize.x * _GridSize.y * _GridSize.z;
    if (id >= cells) return;
    int3 c = int3(id % _GridSize.x,
        (id / _GridSize.x) % _GridSize.y,
        id / (_GridSize.x * _GridSize.y));
    if (!IsFluid(c)) { _PressureDst[id] = 0; return; }
    int3 ex = int3(1,0,0), ey = int3(0,1,0), ez = int3(0,0,1);
    // MAC divergence and gradient are matched finite-volume operators.
    float3 plus = MacAt(c);
    float divergence = (plus.x-MacAt(c-ex).x +
        plus.y-MacAt(c-ey).y + plus.z-MacAt(c-ez).z) / _CellSize;
    float sum = 0.0, neighbors = 0.0;
    int3 a;
    a = c+ex; if (!IsSolid(a)) { neighbors += 1.0; sum += PressureAt(a,0.0); }
    a = c-ex; if (!IsSolid(a)) { neighbors += 1.0; sum += PressureAt(a,0.0); }
    a = c+ey; if (!IsSolid(a)) { neighbors += 1.0; sum += PressureAt(a,0.0); }
    a = c-ey; if (!IsSolid(a)) { neighbors += 1.0; sum += PressureAt(a,0.0); }
    a = c+ez; if (!IsSolid(a)) { neighbors += 1.0; sum += PressureAt(a,0.0); }
    a = c-ez; if (!IsSolid(a)) { neighbors += 1.0; sum += PressureAt(a,0.0); }
    _PressureDst[id] = neighbors > 0.0 ?
        (sum-divergence*_CellSize*_CellSize/max(_Dt,0.0001))/neighbors : 0.0;
}

// Each shared face is pressure-corrected once; solids are impermeable,
// free-surface pressure is zero, and the physical lip stays an interior face.
[numthreads(128,1,1)]
void ProjectFaces(uint id : SV_DispatchThreadID)
{
    uint cells = _GridSize.x * _GridSize.y * _GridSize.z;
    if (id >= cells) return;
    int3 c = int3(id % _GridSize.x,
        (id / _GridSize.x) % _GridSize.y,
        id / (_GridSize.x * _GridSize.y));
    int3 ex = int3(1,0,0), ey = int3(0,1,0), ez = int3(0,0,1);
    bool wet = IsFluid(c);
    float p = wet ? _PressureSrc[id] : 0.0;
    float3 face = _FaceVelocity[id];
    int3 a = c+ex;
    if (IsSolid(c) || IsSolid(a) || (!wet && !IsFluid(a))) face.x = 0.0;
    else face.x -= (_Dt/_CellSize) * (PressureAt(a,0.0)-p);
    a = c+ey;
    if (IsSolid(c) || IsSolid(a) || (!wet && !IsFluid(a))) face.y = 0.0;
    else face.y -= (_Dt/_CellSize) * (PressureAt(a,0.0)-p);
    a = c+ez;
    if (IsSolid(c) || IsSolid(a) || (!wet && !IsFluid(a))) face.z = 0.0;
    else face.z -= (_Dt/_CellSize) * (PressureAt(a,0.0)-p);
    _FaceVelocity[id] = clamp(face, -_MaxFluidVelocity, _MaxFluidVelocity);
}
[numthreads(128,1,1)]
void ProjectGrid(uint id : SV_DispatchThreadID)
{
    uint cells = _GridSize.x * _GridSize.y * _GridSize.z;
    if (id >= cells) return;
    int3 c = int3(id % _GridSize.x,
        (id / _GridSize.x) % _GridSize.y,
        id / (_GridSize.x * _GridSize.y));
    if (!IsFluid(c)) return;
    int3 ex = int3(1,0,0), ey = int3(0,1,0), ez = int3(0,0,1);
    // Sample the already-projected shared faces back onto the old PIC grid.
    float3 face = MacAt(c);
    float3 beforeProjection = _GridVelocity[id];
    float3 v = 0.5 * float3(
        face.x + MacAt(c-ex).x,
        face.y + MacAt(c-ey).y,
        face.z + MacAt(c-ez).z);
    if (_OutflowDiagnosticsEnabled != 0 && InOutflowDiagnosticZone(Center(c)))
    {
        InterlockedAdd(_OutflowDiagnostics[0], 1u);
        if (beforeProjection.z > 0.1)
            InterlockedAdd(_OutflowDiagnostics[1], 1u);
        if (v.z > 0.1)
            InterlockedAdd(_OutflowDiagnostics[2], 1u);
        if (beforeProjection.z <= 0.1 && v.z > 0.1)
            InterlockedAdd(_OutflowDiagnostics[3], 1u);
        InterlockedMax(_OutflowDiagnostics[9],
            (uint)round(max(0.0, beforeProjection.z) * 1000.0));
        InterlockedMax(_OutflowDiagnostics[10],
            (uint)round(max(0.0, v.z) * 1000.0));
    }
    _GridVelocity[id] = v;
}
[numthreads(128,1,1)]
void GridToParticle(uint id : SV_DispatchThreadID)
{
    if (id >= _ParticleCount) return;
    FluidParticle p = _Particles[id];
    if (p.position.w != 1.0) return;
    float3 previousPosition = p.position.xyz;
    float3 g = (p.position.xyz - _GridOrigin) / _CellSize - 0.5;
    int3 baseCell = (int3)floor(g);
    float3 f = frac(g);
    float3 pic = 0, flipDelta = 0, c0 = 0, c1 = 0, c2 = 0;
    float weight = 0;
    [unroll]
    for (int z=0; z<=1; z++)
    [unroll]
    for (int y=0; y<=1; y++)
    [unroll]
    for (int x=0; x<=1; x++)
    {
        int3 c = baseCell + int3(x,y,z);
        if (!IsFluid(c)) continue;
        uint idx = Flatten(c);
        float w = (x==0?1-f.x:f.x)*(y==0?1-f.y:f.y)*(z==0?1-f.z:f.z);
        float3 v = _GridVelocity[idx];
        float3 d = Center(c) - p.position.xyz;
        pic += w*v;
        flipDelta += w*(v-_GridBeforeRead[idx]);
        c0 += w*v*d.x;
        c1 += w*v*d.y;
        c2 += w*v*d.z;
        weight += w;
    }
    if (weight > 0.001)
    {
        pic /= weight;
        flipDelta /= weight;
        p.velocity.xyz = lerp(pic, p.velocity.xyz + flipDelta, _FlipFraction);
        float scale = 4.0 / (_CellSize * _CellSize * weight);
        // Preserve crest height and collision-release tag across APIC updates.
        p.affineX = float4(c0*scale,p.affineX.w);
        p.affineY = float4(c1*scale,p.affineY.w);
        p.affineZ = float4(c2*scale,p.affineZ.w); // preserve lip-crossing tag
    }
    else p.velocity.y -= _Gravity * _Dt;
    p.velocity.xyz = clamp(p.velocity.xyz, -_MaxFluidVelocity, _MaxFluidVelocity);
    p.position.xyz += p.velocity.xyz * _Dt;
    // Fixed banks/floor are collision boundaries, not a prescribed wave shape.
    if (p.position.x < -_HalfWidth + 0.05)
    {
        p.position.x = -_HalfWidth + 0.05;
        p.velocity.x = max(p.velocity.x, 0);
    }
    if (p.position.x > _HalfWidth - 0.05)
    {
        p.position.x = _HalfWidth - 0.05;
        p.velocity.x = min(p.velocity.x, 0);
    }
    if (p.position.y < _FloorY + 0.05 && p.position.z >= _ExitZ)
    {
        p.position.y = _FloorY + 0.05;
        p.velocity.y = max(p.velocity.y, 0);
    }
    bool diagnosticsHere = _OutflowDiagnosticsEnabled != 0 &&
        InOutflowDiagnosticZone(p.position.xyz);
    float preCollisionZ = p.velocity.z;
    if (diagnosticsHere)
    {
        InterlockedAdd(_OutflowDiagnostics[4], 1u);
        if (preCollisionZ > 0.1)
            InterlockedAdd(_OutflowDiagnostics[5], 1u);
    }
    [loop]
    for (uint i=0; i<_ColliderCount; i++)
    {
        FluidCollider b = _Colliders[i];
        float3 dr = p.position.xyz - b.centerBody.xyz;
        if (dot(dr, dr) > b.velocity.w * b.velocity.w) continue;
        float d = SignedDistance(b, p.position.xyz);
        if (_AmbientEnabled != 0 && p.velocity.w > 0.5 &&
            d < _CrestReleaseDistance)
            p.affineY.w = 1.0; // Collision: stop holding this parcel up.
        if (d >= _CollisionSkin) continue;
        float3 n = ColliderNormal(b, p.position.xyz);
        float3 r = p.position.xyz - b.bodyCenter.xyz;
        float3 bv = b.velocity.xyz + cross(b.angular.xyz, r);
        float3 before = p.velocity.xyz;
        float3 relative = before - bv;
        float approaching = min(dot(relative, n), 0.0);
        p.velocity.xyz -= n * approaching * _CollisionResponse;
        p.position.xyz += n * (_CollisionSkin-d);
        int bi = (int)b.centerBody.w;
        if (bi>=0 && bi<(int)_BodyCount)
        {
            float3 impulse = (before-p.velocity.xyz) * _ParticleMass;
            float3 torque = cross(r, impulse);
            uint dst = bi*2;
            InterlockedAdd(_BodyImpulses[dst].x, (int)round(impulse.x*SCALE));
            InterlockedAdd(_BodyImpulses[dst].y, (int)round(impulse.y*SCALE));
            InterlockedAdd(_BodyImpulses[dst].z, (int)round(impulse.z*SCALE));
            InterlockedAdd(_BodyImpulses[dst+1].x, (int)round(torque.x*SCALE));
            InterlockedAdd(_BodyImpulses[dst+1].y, (int)round(torque.y*SCALE));
            InterlockedAdd(_BodyImpulses[dst+1].z, (int)round(torque.z*SCALE));
        }
    }
    // The temporary wave is a deformable volume, not a rigid mesh.
    // The original FLIP pressure solver severely compresses this extra
    // high column into the 1m surface. Counter only that initial collapse
    // with a damped, height-preserving spring on unimpeded crest parcels.
    // Obstacles permanently release the spring, restoring free 3D physics.
    if (_AmbientEnabled != 0 && p.velocity.w > 0.5 && p.affineX.w > 0.0 &&
        p.affineY.w < 0.5 && p.position.z >= _ExitZ)
    {
        float targetY = _FloorY + _AmbientDepth + p.affineX.w;
        float verticalAcceleration = _Gravity +
            _CrestHeightStiffness * (targetY - p.position.y) -
            _CrestHeightDamping * p.velocity.y;
        p.velocity.y += verticalAcceleration * _Dt;
        p.velocity.z = lerp(p.velocity.z, -_CrestSpeed,
            saturate(_CrestForwardDamping * _Dt));
    }
    if (diagnosticsHere)
    {
        if (p.velocity.z > 0.1)
            InterlockedAdd(_OutflowDiagnostics[6], 1u);
        if (preCollisionZ <= 0.1 && p.velocity.z > 0.1)
            InterlockedAdd(_OutflowDiagnostics[7], 1u);
        InterlockedMax(_OutflowDiagnostics[11],
            (uint)round(max(0.0, p.velocity.z) * 1000.0));
    }
    if (_AmbientEnabled != 0 && p.velocity.w > 0.5 && p.position.w == 1.0)
    {
        InterlockedAdd(_CrestMetrics[0], 1u);
        InterlockedMax(_CrestMetrics[1],
            (uint)max(0.0, round((p.position.y - _FloorY) * 100.0)));
        if (p.affineY.w >= 0.5) InterlockedAdd(_CrestMetrics[2], 1u);
    }
    // Count the FIRST physical lip crossing. The particle continues as
    // incompressible FLIP water until it has actually begun falling.
    if (previousPosition.z >= _ExitZ && p.position.z < _ExitZ &&
        p.affineZ.w < 0.5)
    {
        p.affineZ.w = 1.0;
        if (_OutletParticleVolume > 0.0)
        {
            int x = clamp((int)floor((p.position.x-_GridOrigin.x)/_CellSize),
                0, _GridSize.x-1);
            int y = clamp((int)floor((p.position.y-_GridOrigin.y)/_CellSize),
                0, _GridSize.y-1);
            InterlockedAdd(_FlowCounters[4+y*_GridSize.x+x],1u);
        }
        if (_OutflowDiagnosticsEnabled != 0 && abs(p.position.x) <= 8.0)
            InterlockedAdd(_OutflowDiagnostics[8],1u);
        if (_AmbientEnabled != 0)
            InterlockedAdd(_FlowCounters[3],1u);
    }
    // Hand off to ballistic spray ONLY after fluid gravity and pressure
    // have curved the stream below and beyond the cliff.
    if (p.position.z < _ExitZ &&
        (p.position.z <= _ExitZ-_CoupledOutletLength ||
         p.position.y <= _FloorY-_CoupledOutletDepth))
    {
        p.position.w = 2.0;
        // Keep refill mass conservation: debt is raised at handoff, not
        // at initial lip crossing while the same parcel is still liquid.
        if (_AmbientEnabled != 0 && p.velocity.w < 0.5)
            InterlockedAdd(_FlowCounters[0],1u);
    }
    else if (p.position.y > _GridOrigin.y + _GridSize.y*_CellSize - 0.1)
    {
        p.position.w = 0;
        if (_AmbientEnabled != 0 && p.velocity.w < 0.5)
            InterlockedAdd(_FlowCounters[0], 1u);
    }
    _Particles[id] = p;
}

// Independently estimate the physical-lip particle outflow for diagnostics.
// The staggered pressure solver uses its own face flux, not this delayed
// measurement. The 1:2:1 lateral filter and EMA suppress counting noise.
[numthreads(128,1,1)]
void UpdateExitFlux(uint id : SV_DispatchThreadID)
{
    uint faces = (uint)(_GridSize.x * _GridSize.y);
    if (id >= faces) return;
    uint width = (uint)_GridSize.x;
    uint x = id % width;
    uint row = id / width;
    uint left = row * width + (x == 0u ? 0u : x - 1u);
    uint right = row * width + (x + 1u < width ? x + 1u : x);
    uint departures = _FlowCounters[4u + id];
    float filteredCount = 0.25 * (float)_FlowCounters[4u + left] +
        0.5 * (float)departures +
        0.25 * (float)_FlowCounters[4u + right];
    float speed = filteredCount * _OutletParticleVolume /
        max(_Dt * _CellSize * _CellSize, 1e-6);
    // This is a measured boundary flux, not an additional driving force.
    float alpha = 1.0 - exp(-_Dt / 0.12);
    float smoothed = lerp(_LipFaceFlux[id],
        clamp(speed, 0.0, _MaxFluidVelocity), alpha);
    _LipFaceFlux[id] = smoothed;
    if (_OutflowDiagnosticsEnabled != 0)
    {
        InterlockedAdd(_OutflowDiagnostics[12], departures);
        InterlockedAdd(_OutflowDiagnostics[13],
            (uint)round(smoothed * _CellSize * _CellSize * 1000.0));
    }
}

[numthreads(128,1,1)]
void PressureToBodies(uint id : SV_DispatchThreadID)
{
    uint cells = _GridSize.x * _GridSize.y * _GridSize.z;
    if (id >= cells) return;
    int3 c = int3(id % _GridSize.x,
        (id / _GridSize.x) % _GridSize.y,
        id / (_GridSize.x * _GridSize.y));
    if (!IsFluid(c)) return;
    float pressure = clamp(_PressureSrc[id], 0.0, _PressureClamp);
    if (pressure < _PressureThreshold) return;
    float3 pos = Center(c);
    [loop]
    for (uint i = 0; i < _ColliderCount; ++i)
    {
        FluidCollider body = _Colliders[i];
        int bi = (int)body.centerBody.w;
        if (bi < 0 || bi >= (int)_BodyCount) continue;
        float3 dr = pos - body.centerBody.xyz;
        float radius = body.velocity.w + _CellSize;
        if (dot(dr, dr) > radius * radius) continue;
        float distance = SignedDistance(body, pos);
        if (distance < 0 || distance > _CellSize) continue;
        float3 normal = ColliderNormal(body, pos);
        // Reaction of the pressure gradient on the solid surface.
        float3 impulse = -normal * pressure * _HydroDensity * _Dt *
            _CellSize * _CellSize;
        float3 torque = cross(pos - body.bodyCenter.xyz, impulse);
        uint index = (uint)bi * 2;
        InterlockedAdd(_BodyImpulses[index].x, (int)round(impulse.x * SCALE));
        InterlockedAdd(_BodyImpulses[index].y, (int)round(impulse.y * SCALE));
        InterlockedAdd(_BodyImpulses[index].z, (int)round(impulse.z * SCALE));
        InterlockedAdd(_BodyImpulses[index+1].x, (int)round(torque.x * SCALE));
        InterlockedAdd(_BodyImpulses[index+1].y, (int)round(torque.y * SCALE));
        InterlockedAdd(_BodyImpulses[index+1].z, (int)round(torque.z * SCALE));
    }
}

[numthreads(128,1,1)]
void Waterfall(uint id : SV_DispatchThreadID)
{
    if (id >= _ParticleCount) return;
    FluidParticle p = _Particles[id];
    if (p.position.w < 1.5) return;
    // Water beyond the -Z cliff is free-falling spray. The 3D pressure domain
    // stays small; inactive falling particles are excluded from P2G/G2P.
    p.velocity.y -= _Gravity * _Dt;
    p.position.xyz += p.velocity.xyz * _Dt;
    if (p.position.y < _WaterfallEndY || p.position.z < _ExitZ - 80)
        p.position.w = 0;
    _Particles[id] = p;
}
